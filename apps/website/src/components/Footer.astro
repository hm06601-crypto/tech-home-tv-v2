---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/hm06601-crypto/tech-home-tv-v2';
---

<footer class="relative border-t border-surface-800">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <a href={`${base}/`} class="flex items-center gap-3">
        <img src={`${base}/favicon-256x256.png`} alt="" class="h-10 w-10 rounded-lg" width="40" height="40" />
        <span class="font-display text-lg font-semibold text-surface-100">Tech Home TV</span>
      </a>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={`${base}/`} class="text-surface-400 hover:text-surface-100">Downloads</a>
        <a href={repo} class="text-surface-400 hover:text-surface-100">Source code</a>
        <a href="https://techhome.ct.ws" class="text-surface-400 hover:text-surface-100">Website</a>
        <a href="tel:+9647744644492" class="text-surface-400 hover:text-surface-100" dir="ltr">07744644492</a>
      </nav>
    </div>
    <p class="mt-7 max-w-3xl text-sm leading-relaxed text-surface-500">
      Tech Home TV is a media player. It does not host or provide channels, subscriptions, playlists or media. Add only sources you are authorized to use.
      Tech Home TV is based on IPTVnator and retains its MIT license and required attribution.
    </p>
    <div class="mt-6 border-t border-surface-800 pt-5 font-mono text-[11px] text-surface-500">
      MIT License · <a href={`${repo}/blob/main/LICENSE`} class="hover:text-surface-200">Source license</a>
    </div>
  </div>
</footer>

